    pub fn paint_image_with_rounded_clip(
        &mut self,
        bounds: Bounds<Pixels>,
        image_bounds: Bounds<Pixels>,
        clip: ImageRoundedClip,
        data: Arc<RenderImage>,
        frame_index: usize,
        grayscale: bool,
    ) -> Result<()> {
        self.paint_image_internal(bounds, image_bounds, clip.corner_radii, Some(clip.bounds), data, frame_index, grayscale)
    }

