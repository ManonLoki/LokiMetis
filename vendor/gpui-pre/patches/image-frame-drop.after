    /// 移除单帧图集键，不持有像素数据，也不会主动刷新窗口。
    ///
    /// 调用方须先停止重放使用该帧 tile 的 Scene；物理回收遵循后端规则。
    pub fn drop_image_frame(&mut self, params: RenderImageParams) {
        self.sprite_atlas.remove(&params.into());
    }

    /// Returns whether the exact painted frame remains in this window's atlas.
    #[cfg(any(test, feature = "test-support"))]
    pub fn has_image_frame_atlas_entry(&self, params: RenderImageParams) -> bool {
        self.sprite_atlas
            .get_or_insert_with(params.into(), &mut || Ok(None))
            .ok()
            .flatten()
            .is_some()
    }

