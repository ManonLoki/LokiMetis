                            #[cfg(feature = "parent-rounded-clip")]
                            let parent_clip = style.parent_rounded_clip(bounds, window.rem_size());
                            #[cfg(feature = "parent-rounded-clip")]
                            let result = window.with_parent_rounded_clip(parent_clip, |window| {
                                f(&style, scroll_offset, hitbox, window, cx)
                            });
                            #[cfg(not(feature = "parent-rounded-clip"))]
                            let result = f(&style, scroll_offset, hitbox, window, cx);