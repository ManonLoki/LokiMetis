/// 缩放开始只发布原生目标矩形；默认允许 zoom/unzoom，不伪造完成事件。
extern "C" fn window_should_zoom(_: &Object, _: Sel, window: id, target_frame: NSRect) -> BOOL {
    if window != nil {
        // 安全：AppKit delegate 参数为当前 NSWindow 与按值 NSRect；通知中心复制字典。
        unsafe {
            let value: id = msg_send![class!(NSValue), valueWithRect: target_frame];
            let info = NSDictionary::dictionaryWithObject_forKey_(nil, value, ns_string("targetFrame"));
            let center: id = msg_send![class!(NSNotificationCenter), defaultCenter];
            let name = ns_string("LokiMetrisGPUIWindowWillZoomNotification");
            let _: () = msg_send![center, postNotificationName: name object: window userInfo: info];
        }
    }
    YES
}

