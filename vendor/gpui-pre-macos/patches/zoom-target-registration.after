        decl.add_method(
            sel!(windowShouldZoom:toFrame:),
            window_should_zoom as extern "C" fn(_, Sel, *mut AnyObject, NSRect) -> Bool,
        );
        decl.add_method(
            sel!(windowDidResize:),
            window_did_resize as extern "C" fn(_, Sel, *mut AnyObject),
        );