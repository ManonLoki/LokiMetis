                    command_encoder = new_command_encoder_for_texture(
                        &command_buffer,
                        texture,
                        viewport_size,
                        None,
                    )?;
                    #[cfg(feature = "parent-rounded-clip")]
                    // 路径中间pass结束后重建主encoder，所有fragment绑定必须恢复。
                    bind_parent_clips(&command_encoder, &instance_bindings.parent_clip_nodes);
