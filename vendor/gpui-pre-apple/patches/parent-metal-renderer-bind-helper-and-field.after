/// 槽7在所有现有primitive接口中空闲；普通及路径中间encoder必须共用此绑定。
#[cfg(feature = "parent-rounded-clip")]
fn bind_parent_clips(encoder: &ProtocolObject<dyn MTLRenderCommandEncoder>, binding: &InstanceBinding) {
    // SAFETY: The aligned buffer contains shader-compatible ParentClipNode values (or a sentinel).
    // Metal retains the buffer; writer.finish publishes CPU writes before the command buffer commits.
    unsafe { encoder.setFragmentBuffer_offset_atIndex(Some(&binding.buffer), binding.offset, 7); }
}

#[derive(Clone)]
struct InstanceBinding {
    buffer: Retained<ProtocolObject<dyn MTLBuffer>>,
    offset: usize,
}

struct InstanceBindings {
    #[cfg(feature = "parent-rounded-clip")]
    parent_clip_nodes: InstanceBinding,
    quads: InstanceBinding,
    shadows: InstanceBinding,
    underlines: InstanceBinding,
    monochrome_sprites: InstanceBinding,
    polychrome_sprites: InstanceBinding,
    surfaces: InstanceBinding,
}

fn write_instances(scene: &Scene, writer: &mut InstanceBufferWriter) -> Result<InstanceBindings> {
    Ok(InstanceBindings {
        #[cfg(feature = "parent-rounded-clip")]
        // 无父裁切也绑定有效哨兵，避免空Scene的shader资源无效。
        parent_clip_nodes: if scene.parent_clip_nodes.is_empty() {
            writer.write(&[ParentClipNode::default()])?
        } else {
            writer.write(&scene.parent_clip_nodes)?
        },
        quads: writer.write(&scene.quads)?,
        shadows: writer.write(&scene.shadows)?,
        underlines: writer.write(&scene.underlines)?,
        monochrome_sprites: writer.write(&scene.monochrome_sprites)?,
        polychrome_sprites: writer.write(&scene.polychrome_sprites)?,
        surfaces: writer.write_iter(scene.surfaces.iter().map(|surface| SurfaceBounds {
            bounds: surface.bounds,
            content_mask: surface.content_mask,
            #[cfg(feature = "parent-rounded-clip")]
            parent_clip: surface.parent_clip,
        }))?,
    })
}
