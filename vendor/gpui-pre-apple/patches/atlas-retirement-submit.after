/// 编码与提交具有不同生命周期；丢弃尚未提交的返回值会取消图集保留。
struct EncodedFrame {
    command_buffer: Retained<ProtocolObject<dyn MTLCommandBuffer>>,
    atlas_frame: Cell<Option<crate::metal_atlas::MetalAtlasFrame>>,
}

impl std::ops::Deref for EncodedFrame {
    type Target = ProtocolObject<dyn MTLCommandBuffer>;
    /// 沿用上游命令缓冲接口，仅将提交动作截获为图集保活边界。
    fn deref(&self) -> &Self::Target { &self.command_buffer }
}

impl EncodedFrame {
    /// 由真实GPU完成回调归还图集保留，取消编码则随返回值释放。
    fn commit(&self) {
        let atlas_frame = Cell::new(Some(self.atlas_frame.take().expect("Metal frame committed twice")));
        let block = RcBlock::new(move |_: ptr::NonNull<ProtocolObject<dyn MTLCommandBuffer>>| {
            // 所有 GPU 终态都已停止读取；回调只访问图集锁，不进入 UI。
            drop(atlas_frame.take());
        });
        // SAFETY: Metal copies the live block and invokes it after the command buffer stops reading the atlas.
        // The capture owns the frame guard and releases retired allocations through the atlas mutex.
        unsafe { self.command_buffer.addCompletedHandler(RcBlock::as_ptr(&block)); }
        self.command_buffer.commit();
    }
}

