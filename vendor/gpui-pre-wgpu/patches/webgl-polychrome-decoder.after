// WebGL 按 28 个四字节字读取实例，独立圆角视口紧跟原 corner_radii 字段。
fn load_poly_sprite(instance_id: u32) -> PolychromeSprite {
    var cursor = instance_cursor(instance_id * 28u);
    return PolychromeSprite(
        read_word(&cursor),
        read_word(&cursor),
        read_atlas_tile(&cursor),
        read_word(&cursor),
        read_f32(&cursor),
        read_bounds(&cursor),
        read_bounds(&cursor),
        read_corners(&cursor),
        read_bounds(&cursor),
    );
}