{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LokiMetis",
  "identifier": "com.manonloki.lokimetis",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LokiMetis",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "pet",
        "title": "LokiMetis 桌宠",
        "url": "index.html?view=pet",
        "width": 128,
        "height": 128,
        "minWidth": 64,
        "minHeight": 64,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "pet-settings",
        "title": "LokiMetis 桌宠设置",
        "url": "index.html?view=pet-settings",
        "width": 320,
        "height": 470,
        "minWidth": 280,
        "minHeight": 440,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "app-loki-metis"
        ]
      }
    }
  }
}
