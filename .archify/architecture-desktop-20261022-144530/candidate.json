  "cards": [
    {
      "dot": "cyan",
      "title": "用量链路",
      "items": [
        "UsageService 编排扫描与查询；适配器读取原始文件。",
        "core 持有 SQLite I/O，也包含独立的纯业务计算。",
        "WorkBuddy 直接只读项目记录，不写入三类会话索引。"
      ]
    },
    {
      "dot": "violet",
      "title": "独立账户与原生界面",
      "items": [
        "Cursor 账户用量是独立内存视图，不并入本机 Token 总量。",
        "GPUI 主线程消费回执；阻塞 I/O 在后台 owner 中执行。",
        "退出统一收尾服务、偏好与日志，隐藏窗口不等于退出。"
      ]
    },
    {
      "dot": "amber",
      "title": "Hooks、桌宠与皮肤",
      "items": [
        "桌宠与 LAN 发布器分别消费状态；手机不跟随桌宠当前页。",
        "Hook 状态机属于 core；档案与图库由应用驱动读写。",
        "宿主换肤仅 macOS / Windows，通过可信实例 CDP 注入。"
      ]
    },
    {
      "dot": "rose",
      "title": "移动信任边界",
      "items": [
        "mDNS 仅发现端点；配对落盘与每次 Resume 认证才授信。",
        "TCP 同步图文；只读 HTTP 摘要移除正文与图片。",
        "pairing 是共享密码库；mobile_bridge 编入移动 App。"
      ]
    }
  ]
}
